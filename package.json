{
  "name": "lunar-evacuation-race",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node sandbox/server.mjs",
    "hardware": "node sandbox/server.mjs --hardware",
    "mock": "node sandbox/mock-client.mjs",
    "dev": "node sandbox/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:sandbox": "node --test tests/sandbox*.test.mjs",
    "format": "prettier --write sandbox dist/sandbox dist/sandbox.html dist/shared \"tests/sandbox*.test.mjs\"",
    "format:check": "prettier --check sandbox dist/sandbox dist/sandbox.html dist/shared \"tests/sandbox*.test.mjs\"",
    "assets:routes": "node tools/export_routes.mjs",
    "vendor": "node tools/vendor_three.mjs",
    "sandbox": "node sandbox/server.mjs",
    "sandbox:hardware": "node sandbox/server.mjs --hardware",
    "sandbox:mock": "node sandbox/mock-client.mjs"
  },
  "dependencies": {
    "three": "0.180.0",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "prettier": "3.4.2"
  },
  "description": "Moonfall 双人月球车竞速：三段实体赛道联调沙盒与独立 3D 视觉原型",
  "engines": {
    "node": ">=20"
  }
}
